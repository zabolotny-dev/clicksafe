# --- Postgres Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=clicksafe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- SMTP Configuration ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=
SMTP_SSL=

# --- Auth ---
AUTH_TOKEN_HASH_KEY=12345678901234567890123456789012
AUTH_LOGIN_REQUESTS_PER_MINUTE=10
AUTH_LOGIN_BURST=10
AUTH_LOGIN_EXPIRES_IN=3m

# --- API HTTP ---
API_WEB_READ_TIMEOUT=60s
API_WEB_WRITE_TIMEOUT=12m
API_WEB_IDLE_TIMEOUT=120s

# --- API Voice ---
API_VOICE_CLONE_TIMEOUT=10m
API_VOICE_ASR_TIMEOUT=5m
API_VOICE_HEALTH_TTL=1200ms
API_VOICE_OUTPUT_CHUNK_SIZE=65536

# --- Max Adapter ---
MAX_ADAPTER_GRPC_TOKEN=change-me-internal-token
MAX_ADAPTER_SECRET_KEY=change-me-32-plus-byte-secret

# --- Voice Adapter ---
# Voice adapter is optional and runs behind the "voice" compose profile.
#
# CPU:
#   make voice-build
#   make voice-up
#
# GPU/NVIDIA:
#   1. Install NVIDIA Container Toolkit on the Docker host.
#   2. Run:
#        make voice-gpu-build
#        make voice-gpu-up
#   GPU target uses zarf/compose/docker-compose.voice-gpu.yml, which selects
#   CUDA PyTorch wheels and runs the adapter with cuda:0/float16.
API_VOICE_ADAPTER_ADDR=voice-adapter:9091
VOICE_ADAPTER_GRPC_TOKEN=change-me-voice-internal-token

VOICE_ADAPTER_MODEL_PROVIDER=omnivoice
VOICE_ADAPTER_MODEL_ID=k2-fsa/OmniVoice
VOICE_ADAPTER_DEVICE=auto
VOICE_ADAPTER_DTYPE=auto
VOICE_ADAPTER_LOAD_ASR=true
VOICE_ADAPTER_ASR_PROVIDER=gigaam_onnx
VOICE_ADAPTER_ASR_MODEL_ID=gigaam-v3-e2e-rnnt
VOICE_ADAPTER_ASR_REVISION=
VOICE_ADAPTER_ASR_TRUST_REMOTE_CODE=false
VOICE_ADAPTER_CONCURRENCY=1
# Model caches are persisted in the voice_adapter_data Docker volume.
HF_TOKEN=
